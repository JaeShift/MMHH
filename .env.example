# Copy to `.env.local` for local development (never commit real secrets).

# Google Business Profile: embed your reviews widget here.
# In Google Maps, open your business > Share > Embed a map (or use the Place reviews embed URL from Google Business Profile).
# Google reviews page URL (used as an outbound link; embedding in an iframe is blocked by Google).
# Example (replace with your place id if different):
NEXT_PUBLIC_GOOGLE_REVIEWS_EMBED_SRC=https://search.google.com/local/reviews?placeid=ChIJG7sxOsKNOIgR1oQ2lMoYyIY
